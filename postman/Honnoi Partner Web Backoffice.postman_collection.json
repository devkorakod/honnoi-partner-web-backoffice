  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const CryptoJS = require('crypto-js');",
          "",
          "const SKIP_EXACT_PATHS = ['/auth/2fa/send-otp', '/auth/2fa/verify'];",
          "",
          "(function encryptBodyIfNeeded() {",
          "    if (pm.request.method === 'GET') return;",
          "    if (!pm.request.body || pm.request.body.mode !== 'raw') return;",
          "",
          "    const pathParts = pm.request.url ? pm.request.url.path : [];",
          "    const joinedPath = '/' + pathParts.join('/');",
          "    if (SKIP_EXACT_PATHS.includes(joinedPath)) return;",
          "",
          "    const aesKeyB64 = pm.collectionVariables.get('aesKey');",
          "    const aesIvB64 = pm.collectionVariables.get('aesIv');",
          "",
          "    if (!aesKeyB64 || !aesIvB64) {",
          "        console.warn('[auto-encrypt] aesKey / aesIv not set - sending body as-is');",
          "        return;",
          "    }",
          "",
          "    const rawBody = pm.request.body.raw || '';",
          "    let parsed;",
          "    try {",
          "        parsed = JSON.parse(rawBody);",
          "    } catch (e) {",
          "        return;",
          "    }",
          "",
          "    const alreadyEncrypted =",
          "        parsed && typeof parsed === 'object' &&",
          "        Object.keys(parsed).length === 1 && 'payload' in parsed;",
          "    if (!parsed || alreadyEncrypted) return;",
          "",
          "    const key = CryptoJS.enc.Base64.parse(aesKeyB64);",
          "    const iv = CryptoJS.enc.Base64.parse(aesIvB64);",
          "",
          "    const encrypted = CryptoJS.AES.encrypt(JSON.stringify(parsed), key, {",
          "        iv: iv,",
          "        mode: CryptoJS.mode.CBC,",
          "        padding: CryptoJS.pad.Pkcs7",
          "    });",
          "",
          "    const cipherBase64 = encrypted.ciphertext.toString(CryptoJS.enc.Base64);",
          "    pm.request.body.update(JSON.stringify({ payload: cipherBase64 }));",
          "})();"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "aesKey",
      "value": "",
      "description": "Base64 AES-256 key (same as SECRETMANAGER_ID_AES_KEY). Set as a secret in your environment, not here."
    },
    {
      "key": "aesIv",
      "value": "",
      "description": "Base64 AES IV (same as SECRETMANAGER_ID_AES_IV). Set as a secret in your environment, not here."
    },
    {
      "key": "staffToken",
      "value": "",
      "description": "Captured automatically from auth/login_bo_user"
    },
    {
      "key": "partnerToken",
      "value": "",
      "description": "Captured automatically from auth/login or auth/2fa/verify"
    },
    {
      "key": "pendingToken",
      "value": "",
      "description": "Captured automatically from auth/login when twofa_required is true"
    },
    {
      "key": "refCode",
      "value": "",
      "description": "Captured automatically from the last OTP request"
    },
    {
      "key": "userId",
      "value": "",
      "description": "Set after createPartnerUser to reuse in other partner_user requests"
    }
  ]
